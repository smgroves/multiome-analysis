# Large CellOracle benchmark method outputs (294MB) — regenerate from the Google Drive archive
benchmarking/data/celloracle/inference_results/
benchmarking/data/celloracle/*.parquet
benchmarking/__pycache__/
benchmarking/benchmarking_out/

# Raw benchmark input data (large) — download via benchmarking script
benchmarking/data/tabula_muris/
benchmarking/data/cusanovich_atac/
benchmarking/data/preprocessed/
*.pyc

# Journal supplementary tables (third-party, some multi-MB) — see benchmarking/README.md
# "Sourcing a real SCLC ground truth" for provenance; the small derived edge CSVs we built
# from them (borromeo2016_ascl1_human_chip.csv, pozo2021_ascl1_direct.csv) are NOT ignored.
benchmarking/data/sclc_chipseq_gt/*.xlsx

# SCENIC cisTarget databases (~410MB, downloaded from resources.aertslab.org, re-downloadable
# — see comparison_scenic_fit_6667.py) and its run intermediates.
benchmarking/data/scenic/

# Preprocessed genome-wide SCLC/AA expression data (~206MB), derived from the source Box
# multiome dataset — see preprocess_sclc_full_6667.py to regenerate from Box.
benchmarking/data/sclc_full/
